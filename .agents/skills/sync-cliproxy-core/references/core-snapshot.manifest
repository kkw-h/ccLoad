# kind|field1|field2[|field3|field4|field5]
# root rows define deterministic upstream -> local path mapping.
# review rows are the exact non-excluded core + provider delta for the latest atomic sync.
# delete rows record an upstream removal, its removed local path, and the base blob.
# skip-test rows require an exact newly-added upstream test symbol and a review reason.
snapshot|internal/protocol/cliproxy
root|internal/translator|internal/protocol/cliproxy
root|internal/signature|internal/protocol/cliproxy/signature
root|internal/thinking|internal/protocol/cliproxy/thinking
root|internal/util|internal/protocol/cliproxy/util

# Special mappings whose names or destinations are not covered by a root row.
file|source|internal/misc/mime-type.go|internal/protocol/cliproxy/misc/mime_type.go|6c7fcafd6003880c81a3c9f964684bc74acbf31d|6c7fcafd6003880c81a3c9f964684bc74acbf31d
file|source|internal/registry/models/models.json|internal/protocol/cliproxy/registry/models/models.json|52b6b1ed2c8524124434b04825e569444f03a1a7|52b6b1ed2c8524124434b04825e569444f03a1a7

# ccLoad-owned pure wire helpers with no direct upstream source file.
local|source|internal/protocol/cliproxy/common/anthropic_response.go|ccload-native-anthropic-wire|c018c7ac308d69eadbb8b38193b8a57b44591fa0
local|source|internal/protocol/cliproxy/registry/models.go|static-catalog-loader|67391b80755fddea6031db117bbf66b4b3b3f486
local|test|internal/protocol/cliproxy/registry/models_test.go|model-capability-contract|1a8ebc98ef93da6d441ba0dca14be03b3ca288db
local|source|internal/protocol/cliproxy/util/function_name.go|ccload-function-name-normalization|a08a75d94b772b9fe3b79a9cd3b2e9288196f39b

# Translator runtime registration, unsupported protocols, no-op paths, and benchmarks.
exclude|internal/translator/init.go|dynamic-registry
exclude|internal/translator/*/init.go|dynamic-registry
exclude|internal/translator/*/noop_optimization_test.go|private-allocation-behavior
exclude|internal/translator/*_benchmark_test.go|performance-only
exclude|internal/translator/interactions/*.go|unsupported-interactions-wire
exclude|internal/translator/*/interactions/*.go|unsupported-interactions-wire
exclude|internal/translator/common/interactions_usage.go|interactions-only
exclude|internal/translator/gemini/gemini/*.go|same-protocol-passthrough
exclude|internal/translator/openai/openai/chat-completions/*.go|same-protocol-passthrough
exclude|internal/translator/translator/*.go|sdk-dynamic-registry

# Runtime thinking application is intentionally outside the pure conversion core.
exclude|internal/thinking/apply.go|runtime-thinking-application
exclude|internal/thinking/apply_*_test.go|runtime-thinking-application
exclude|internal/thinking/errors.go|runtime-thinking-application
exclude|internal/thinking/kimi_max_clamp_repro_test.go|runtime-thinking-application
exclude|internal/thinking/provider/*.go|runtime-provider-policy
exclude|internal/thinking/strip.go|runtime-thinking-application
exclude|internal/thinking/summary.go|runtime-thinking-application
exclude|internal/thinking/summary_test.go|runtime-thinking-application
exclude|internal/thinking/validate.go|runtime-thinking-application

# Unrelated runtime utilities. New util files remain unclassified and fail closed.
exclude|internal/util/claude_model.go|runtime-model-helper
exclude|internal/util/claude_model_test.go|runtime-model-helper
exclude|internal/util/claude_tool_result_test.go|private-helper-test
exclude|internal/util/header_helpers.go|runtime-http-helper
exclude|internal/util/header_helpers_test.go|runtime-http-helper
exclude|internal/util/image.go|runtime-image-helper
exclude|internal/util/nocopy_invariant_test.go|private-allocation-behavior
exclude|internal/util/provider.go|runtime-provider-helper
exclude|internal/util/proxy.go|runtime-proxy-helper
exclude|internal/util/sanitize_test.go|runtime-sanitizer-test
exclude|internal/util/ssh_helper.go|runtime-network-helper
exclude|internal/util/util.go|runtime-general-helper

# Runtime GitHub token lookup belongs to the application/runtime boundary.
exclude|internal/util/github.go|runtime-github-token-helper
exclude|internal/util/github_test.go|runtime-github-token-helper-test

